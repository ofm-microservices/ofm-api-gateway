APP_ENV=local
LOG_LEVEL=info

HTTP_HOST=0.0.0.0
HTTP_PORT=8080

WS_PATH=/ws

JWT_ACCESS_SECRET=local-dev-access-secret-change-me

REGISTRATION_SAGA_ADDRESS=127.0.0.1:9090
AUTH_SERVICE_ADDRESS=127.0.0.1:9091
GIG_SERVICE_ADDRESS=127.0.0.1:9093
MONOLITH_BASE_URL=http://127.0.0.1:8000
MONOLITH_HTTP_TIMEOUT=5s
MIGRATION_SESSION_AFFINITY_TTL=20m
MIGRATION_REDIS_HOST=127.0.0.1
MIGRATION_REDIS_PORT=6383
MIGRATION_REDIS_PASSWORD=
MIGRATION_REDIS_DB=0
MIGRATION_AUTH_MODE=microservice
MIGRATION_USER_MODE=microservice
MIGRATION_REGISTRATION_MODE=microservice
MIGRATION_ONBOARDING_MODE=monolith
MIGRATION_GIG_MODE=monolith
MIGRATION_ORDER_MODE=monolith
MIGRATION_PAYMENT_MODE=monolith
MIGRATION_REVIEW_MODE=monolith
MIGRATION_SEARCH_MODE=monolith
MIGRATION_AUTH_READ_FALLBACK=false
